<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Formulário - Perfil de Desenvolvedor</title>

    <style>
        boby {
            font-family: Arial, Helvetica, sans-serif;
            background-color: #f2f2f2;
            margin
        }

        form { 
            max-width: 700px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 10px;
        }

        h1 {
            text-align: center;
        }

        section {
            margin-bottom: 30px;
        }

        h2 {
            border-bottom: 2px solid #333;
            padding-bottom: 8px;
        }

        label {
            display: block;
            margin-top: 15px;
            font-weight: bold;
        }

        input[type="text"]
        input[type="email"]
        input[type="number"]
        input[type="tel"]
        input[type="url"]
        textarea,
        select {
            width: 100%;
            padding: 10px;
            margin-top: 5px;
            box-sizing: border-box;
            border: none;
            border-bottom: 2px solid #999;
            outline: none;
        }

        textarea {
            height: 100px;
            resize: vertical;
        }

        .opcao {
            font-weight: normal;
            margin-top: 8px;
        }

        .opcao input {
            width: auto;
        }

        button {
            padding: 12px 20px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            margin-right: 10px;
        }

        .enviar {
            background-color: #333;
            color: white;
        }

        .limpar {
            background-color: #ddd;
        }

    </style>
</head>

<body>

    <form action="https://postman-echo.com/post" method="POST">

        <h1>Perfil de Desenvolvedor</h1>

        <section>
            <h2>Informações Pessoais</h2>

            <label for="nome">1. Nome Completo:</label>
            <input type="text"
            id="nome"
            name="nome"
            placeholder="Digite seu nome completo"
            required>

            <label for="idade">2. Idade:</label>
            <input type="number"
            id="idade"
            name="idade"
            min="14"
            max="100"
            placeholder="Digite sua idade">

            <label for="email">3. E-mail:</label>
            <input type="email"
            id="email"
            name="email"
            placeholder="exemplo@gmail.com"
            required>

            <label for="telefone">4. Telefone:</label>
            <input type="tel"
            id="telefone"
            name="telefone"
            placeholder="(43) 99999-9999"
            pattern="\([0-9] {2}\) [0-9]{5}-[0-9]{4}">

            <label for="cidade">5. Cidade:</label>
            <input type="text"
            id="cidade"
            name="cidade"
            placeholder="Digite sua cidade">

            <label for="linkedin">6. Linkedin:</label>
            <input type="url"
            id="linkedin"
            name="linkedin"
            placeholer="https://www.linkedin.com/in/seu-perfil">

        </section>

        <section>
            <h2>Perfil profissional</h2>

            <label for="curso">7. Curso:</label>
            <input type="text"
            id="curso"
            name="curso"
            placeholder="Ex: Engenharia de Software">

            <label for="nivel">8. Nivel de conhecimento:</label>
            <select id="nivel" name="nivel" required>
                <option value="">Selecione uma opção</option>
                <option value="iniciante">Iniciante</option>
                <option value="intermediariario">Intermediário</option>
                <option value="avancado">Avançado</option>
            </select>

            <label for="experiencia">9. Possui experiência profissional?</label>

            <label class="opcao">
                <input type="radio" name="experiencia" value="sim"> SIM
            </label>

            <label class="opcao">
                <input type="radio" name="experiencia" value="nao"> NÃO
            </label>

            <label for="objetivo">10. Qual seu objetivo profissional?</label>
            <input type="text"
            id="objetivo"
            name="objetivo"
            placeholder="Ex: Trabalhar como desenvolvedor">
        </section>

        <section>
            <h2>Conhecimentos em programação</h2>

            <p><strong>11. Quais linguagens voce conhece?</strong></p>

            <label class="opcao">
                <input type="checkbox" name="linguagens" value="html"> HTML
            </label>

            <label class="opcao">
                <input type="checkbox" name="linguagens" value="css"> CSS
            </label>

            <label class="opcao">
                <input type="checkbox" name="linguagens" value="javascript"> JavaScript
            </label>

            <label class="opcao">
                <input type="checkbox" name="linguagens" value="python"> Python
            </label>

            <label class="opcao">
                <input type="checkbox" name="linguagens" value="java"> Java
            </label>

            <label class="opcao">
                <input type="checkbox" name="linguagens" value="c"> C
            </label>

            <label class="opcao">
                <input type="checkbox" name="linguagens" value="c++"> C++
            </label>

            <label class="opcao">
                <input type="checkbox" name="linguagens" value="c#"> C#
            </label>

            <label for="banco">12. Qual banco de dados voce conhece?</label>
            <input type="text"
            id="banco"
            name="banco"
            placeholder="Ex: MySQL, PostgreSQL">

            <label for="projeto">13. Já desenvolveu algum projeto?</label>
            <select id="projeto" name="projeto">
                <option value="">Selecione</option>
                <option value="sim">Sim</option>
                <option value="nao">Não</option>
            </select>
        </section>
    </form>
</body>
</html>
